# macOS file system data
.DS_Store

# Personal Claude Code settings
.claude/settings.local.json

# Files generated by invoking Julia with --code-coverage
*.jl.cov
*.jl.*.cov

# Coverage report assembled for Codecov, and the uploader binary itself
lcov.info
/codecov

# Files generated by invoking Julia with --track-allocation
*.jl.mem
*.jl.*.mem

# Figures generated by the example scripts
*.png

# Trained parameters saved by the example scripts
*.jld2

# Weights saved by scripts/pendulum/train_sae.jl. The figures its companion draws are covered by the
# `*.png` rule above.
/pendulum_sae.h5

# Reports, loss curves and logs written by scripts/geometric_optimizers/mnist_cuda.jl and
# scripts/geometric_optimizers/mnist_cuda_repetitions.jl, wherever they are started from
/results
mnist_cuda_report.txt
mnist_cuda_losses.csv
mnist_repetitions_report.txt
mnist_repetitions_losses.csv

# Files generated by Jupyter notebook
.ipynb_checkpoints

# Build artifacts for creating documentation generated by the Documenter package
docs/build/
docs/site/

# File generated by Pkg, the package manager, based on a corresponding Project.toml
# It records a fixed state of all packages used by the project. As such, it should not be
# committed for packages, but should be committed for applications that require a static
# environment.
Manifest.toml
